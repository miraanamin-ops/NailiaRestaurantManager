{
  "expo": {
    "name": "DinerAI",
    "slug": "dinerai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dinerai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "uk.co.dinerai.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0c0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uk.co.dinerai.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0c0a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DinerAI to use Face ID to unlock the app."
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DinerAI to use your photos, so you can send dish photos and till reports in Chat.",
          "cameraPermission": "Allow DinerAI to use the camera, so you can photograph dishes and till reports in Chat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#c8f03c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "736f7735-ff02-4238-a5ac-1368ea4f48ae"
      }
    },
    "owner": "miraanamin"
  }
}
